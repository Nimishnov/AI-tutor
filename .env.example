# Public project connection values only. These are safe for browser use when RLS is enabled.
# Copy this file to .env.local and replace the placeholders for local development.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Manus Preview can keep using its injected managed AI credentials without these values.
# OPENAI_API_KEY belongs only in Supabase Edge Function secrets; never add it here.
